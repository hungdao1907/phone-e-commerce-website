generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum PaymentMethod {
  COD
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUNDED
}

model Plan {
  id            String   @id @default(uuid())
  title         String
  date          String
  time          String
  location      String
  participants  String[]
  googleEventId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Customer {
  id        String    @id @default(uuid())
  fullName  String
  email     String    @unique
  phone     String?
  address   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  otp       String?
  otpExpiry DateTime?
  password  String
  verified  Boolean   @default(false)
  Dispute   Dispute[]
  Order     Order[]
  Review    Review[]
}

model Category {
  id         String              @id @default(uuid())
  name       String
  slug       String              @unique
  icon       String?
  parentId   String?
  isActive   Boolean             @default(true)
  sortOrder  Int                 @default(0)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  parent     Category?           @relation("CategoryTree", fields: [parentId], references: [id])
  children   Category[]          @relation("CategoryTree")
  attributes CategoryAttribute[]
  products   Product[]
}

model CategoryAttribute {
  id         String   @id @default(uuid())
  name       String
  values     String[]
  colorCodes String[]
  categoryId String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}

model Product {
  id             String           @id @default(uuid())
  name           String
  status         String           @default("active")
  image          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  categoryId     String?
  description    String?
  specifications Json?
  brand          String?
  images         String[]
  category       Category?        @relation(fields: [categoryId], references: [id])
  variants       ProductVariant[]
  Review         Review[]
  Dispute        Dispute[]
}

model ProductVariant {
  id         String      @id @default(uuid())
  sku        String      @unique
  price      Int
  stock      Int         @default(0)
  attributes Json
  colorCode  String?
  image      String?
  productId  String
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  salePrice  Int?
  OrderItem  OrderItem[]
  Review     Review[]
  Dispute    Dispute[]
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Order {
  id                String    @id @default(uuid())
  orderCode         String    @unique
  customerId        String
  customer          Customer  @relation(fields: [customerId], references: [id])
  status            String    @default("pending") // pending, pending_payment, confirmed, shipping, delivered, completed, cancelled, returned
  paymentMethod     String    @default("COD") // COD, BANK_TRANSFER
  paymentStatus     String    @default("PENDING") // PENDING, PAID, REFUNDED
  shippingAddress   String
  shippingPhone     String
  shippingFee       Int       @default(0)
  totalAmount       Int
  discountAmount    Int       @default(0)
  promoCodeId       String?
  note              String?
  estimatedDelivery DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  Dispute Dispute[]
  Invoice Invoice?
  items   OrderItem[]
  Payment Payment[]
  Review  Review[]
}

model OrderItem {
  id          String         @id @default(uuid())
  orderId     String
  variantId   String
  productName String
  variantInfo String
  quantity    Int
  unitPrice   Int
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant     ProductVariant @relation(fields: [variantId], references: [id])
  Review      Review[]
  Dispute     Dispute[]
}

model Review {
  id          String   @id @default(uuid())
  orderId     String?
  customerId  String
  productId   String
  variantId   String?
  orderItemId String?  @unique
  rating      Int
  comment     String?
  images      String[]
  status      String   @default("PENDING")
  experienceRatings Json?

  adminReply   String?
  adminReplyAt DateTime?
  adminReplyBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer  Customer        @relation(fields: [customerId], references: [id])
  order     Order?          @relation(fields: [orderId], references: [id])
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  orderItem OrderItem?      @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@unique([customerId, productId])
}

model Dispute {
  id          String   @id @default(uuid())
  orderId     String
  customerId  String
  
  orderItemId String
  productId   String
  variantId   String

  reason      String
  description String
  images      String[]
  status      String   @default("PENDING")
  resolution  String?
  
  adminReplyAt DateTime?
  adminReplyBy String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  customer    Customer @relation(fields: [customerId], references: [id])
  order       Order    @relation(fields: [orderId], references: [id])
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])
  product     Product   @relation(fields: [productId], references: [id])
  variant     ProductVariant @relation(fields: [variantId], references: [id])
}

model Invoice {
  id          String   @id @default(uuid())
  invoiceCode String   @unique
  orderId     String   @unique
  subtotal    Int
  shippingFee Int
  tax         Int      @default(0)
  total       Int
  issuedAt    DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  order       Order    @relation(fields: [orderId], references: [id])
}

model Payment {
  id              String        @id @default(uuid())
  orderId         String
  order           Order         @relation(fields: [orderId], references: [id])
  method          PaymentMethod
  amount          Int
  status          PaymentStatus @default(PENDING)
  transactionCode String?
  transferContent String?
  qrData          String?
  expiresAt       DateTime?
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

// ========== MARKETING & BANNER ==========
model Campaign {
  id            String   @id @default(uuid())
  name          String
  description   String?
  discountType  String
  discountValue Int
  startDate     DateTime
  endDate       DateTime
  isActive      Boolean  @default(true)
  appliesTo     String
  targetIds     String[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  bannerUrl     String?
}

model PromoCode {
  id            String   @id @default(uuid())
  code          String   @unique
  discountType  String // percentage, fixed
  discountValue Int
  startDate     DateTime
  endDate       DateTime
  isActive      Boolean  @default(true)
  usageLimit    Int      @default(0)
  usedCount     Int      @default(0)
  minOrderValue Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Banner {
  id        String    @id @default(uuid())
  title     String
  image     String
  link      String?
  position  String
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model FooterSection {
  id            String  @id @default(uuid())
  type          String
  title         String?
  copyrightText String?
  sortOrder     Int     @default(0)
  isActive      Boolean @default(true)

  links FooterLink[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, sortOrder])
}

model FooterLink {
  id        String  @id @default(uuid())
  sectionId String
  label     String
  url       String
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  section FooterSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sectionId, sortOrder])
}

// ========== GIỎ HÀNG & PHẦN THƯỞNG ==========

model RewardMilestone {
  id        String   @id @default(uuid())
  amount    Int
  label     String
  type      String
  discount  Int?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ========== CRM (LEADS) ==========

model Lead {
  id           String            @id @default(uuid())
  fullName     String
  email        String?
  phone        String?
  source       String            @default("Website") // Website, Facebook, Zalo, TikTok, AI Chatbot, Khác
  status       String            @default("new") // new, contacted, consulting, considering, quoted, converted, no_interest, unreachable
  leadScore    Int               @default(0) // 0-100
  interestedIn String? // Sản phẩm quan tâm
  assignedTo   String? // Nhân viên phụ trách (có thể là tên hoặc ID)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  interactions LeadInteraction[]
}

model LeadInteraction {
  id        String   @id @default(uuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      String // message, call, status_change, note
  content   String
  createdBy String? // AI, Admin, System, Khách
  createdAt DateTime @default(now())
}

// ========== NOTIFICATIONS ==========

model Notification {
  id            String   @id @default(uuid())
  type          String // ORDER, REVIEW, DISPUTE, INVENTORY, CUSTOMER, PAYMENT
  title         String
  message       String
  isRead        Boolean  @default(false)
  referenceType String? // Order, Review, Dispute, Product, Customer
  referenceId   String? // ID của entity liên quan
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([createdAt(sort: Desc)])
  @@index([type])
  @@index([isRead])
}
