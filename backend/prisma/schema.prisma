generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum PaymentMethod {
  COD
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUNDED
}

model Plan {
  id            String   @id @default(uuid())
  title         String
  date          String
  time          String
  location      String
  participants  String[]
  googleEventId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Customer {
  id        String    @id @default(uuid())
  fullName  String
  email     String    @unique
  password  String
  phone     String?
  address   String?
  verified  Boolean   @default(false)
  otp       String?
  otpExpiry DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  Order     Order[]
  Review    Review[]
  Dispute   Dispute[]
}

// ========== DANH MỤC & THUỘC TÍNH ==========

model Category {
  id         String              @id @default(uuid())
  name       String
  slug       String              @unique
  icon       String? // icon type: smartphone, tablet, headphones, etc.
  parentId   String?
  parent     Category?           @relation("CategoryTree", fields: [parentId], references: [id])
  children   Category[]          @relation("CategoryTree")
  isActive   Boolean             @default(true)
  sortOrder  Int                 @default(0)
  attributes CategoryAttribute[]
  products   Product[]
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
}

model CategoryAttribute {
  id         String   @id @default(uuid())
  name       String // e.g. "Màu sắc", "Dung lượng"
  values     String[] // e.g. ["Đen Titan", "Trắng Titan", "256GB", "512GB"]
  colorCodes String[] // hex codes parallel to values, e.g. ["#1f1f1f", "#f5f5f0"]
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ========== SẢN PHẨM & BIẾN THỂ ==========

model Product {
  id             String           @id @default(uuid())
  name           String
  description    String?
  brand          String?          // Thương hiệu (Apple, Samsung...)
  image          String?          // ảnh đại diện chính (cover)
  images         String[]         // thư viện ảnh phụ (gallery)
  categoryId     String?
  category       Category?        @relation(fields: [categoryId], references: [id])
  status         String           @default("active") // draft, active, inactive, discontinued
  specifications Json?            // Thông số kỹ thuật (RAM, Pin, Màn hình...)
  variants       ProductVariant[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model ProductVariant {
  id         String      @id @default(uuid())
  sku        String      @unique
  price      Int
  salePrice  Int?        // giá sau khi giảm
  stock      Int         @default(0)
  attributes Json // e.g. {"Màu sắc": "Đen Titan", "Dung lượng": "256GB"}
  colorCode  String? // hex color for UI display, e.g. "#1f1f1f"
  image      String? // ảnh riêng cho biến thể
  productId  String
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  OrderItem  OrderItem[]
}

// ========== ĐƠN HÀNG ==========

model Order {
  id                String      @id @default(uuid())
  orderCode         String      @unique
  customerId        String
  customer          Customer    @relation(fields: [customerId], references: [id])
  status            String      @default("pending") // pending, pending_payment, confirmed, shipping, delivered, completed, cancelled, returned
  paymentMethod     String      @default("COD") // COD, BANK_TRANSFER
  paymentStatus     String      @default("PENDING") // PENDING, PAID, REFUNDED
  shippingAddress   String
  shippingPhone     String
  shippingFee       Int         @default(0)
  totalAmount       Int
  discountAmount    Int         @default(0)
  promoCodeId       String?
  note              String?
  estimatedDelivery DateTime?
  items             OrderItem[]
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  Review            Review[]
  Dispute           Dispute[]
  Invoice           Invoice?
  Payment           Payment[]
}

model OrderItem {
  id          String         @id @default(uuid())
  orderId     String
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId   String
  variant     ProductVariant @relation(fields: [variantId], references: [id])
  productName String
  variantInfo String
  quantity    Int
  unitPrice   Int
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

// ========== ĐÁNH GIÁ, KHIẾU NẠI & HÓA ĐƠN ==========

model Review {
  id         String   @id @default(uuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id])
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  rating     Int
  comment    String?
  images     String[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Dispute {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id])
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])
  reason      String
  description String
  images      String[]
  status      String   @default("open") // open, processing, resolved, rejected
  resolution  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Invoice {
  id          String   @id @default(uuid())
  invoiceCode String   @unique
  orderId     String   @unique
  order       Order    @relation(fields: [orderId], references: [id])
  subtotal    Int
  shippingFee Int
  tax         Int      @default(0)
  total       Int
  issuedAt    DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Payment {
  id              String         @id @default(uuid())
  orderId         String
  order           Order          @relation(fields: [orderId], references: [id])
  method          PaymentMethod
  amount          Int
  status          PaymentStatus  @default(PENDING)
  transactionCode String?
  transferContent String?
  qrData          String?
  expiresAt       DateTime?
  paidAt          DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

// ========== MARKETING & BANNER ==========

model Campaign {
  id            String   @id @default(uuid())
  name          String
  description   String?
  discountType  String   // percentage, fixed
  discountValue Int
  startDate     DateTime
  endDate       DateTime
  isActive      Boolean  @default(true)
  appliesTo     String   // all, category, product
  targetIds     String[] // list of category or product ids
  bannerUrl     String?  // URL of the campaign banner image
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model PromoCode {
  id            String   @id @default(uuid())
  code          String   @unique
  discountType  String   // percentage, fixed
  discountValue Int
  startDate     DateTime
  endDate       DateTime
  isActive      Boolean  @default(true)
  usageLimit    Int      @default(0)
  usedCount     Int      @default(0)
  minOrderValue Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Banner {
  id          String    @id @default(uuid())
  title       String
  image       String
  link        String?
  position    String    // homepage, category, popup
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ========== GIỎ HÀNG & PHẦN THƯỞNG ==========

model RewardMilestone {
  id        String   @id @default(uuid())
  amount    Int      
  label     String   
  type      String   
  discount  Int?     
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ========== CRM (LEADS) ==========

model Lead {
  id              String            @id @default(uuid())
  fullName        String
  email           String?
  phone           String?
  source          String            @default("Website") // Website, Facebook, Zalo, TikTok, AI Chatbot, Khác
  status          String            @default("new")     // new, contacted, consulting, considering, quoted, converted, no_interest, unreachable
  leadScore       Int               @default(0)         // 0-100
  interestedIn    String?           // Sản phẩm quan tâm
  assignedTo      String?           // Nhân viên phụ trách (có thể là tên hoặc ID)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  interactions    LeadInteraction[]
}

model LeadInteraction {
  id        String   @id @default(uuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      String   // message, call, status_change, note
  content   String
  createdBy String?  // AI, Admin, System, Khách
  createdAt DateTime @default(now())
}
